{
  "name": "arrowops",
  "version": "0.3.0",
  "description": "ArrowOps - gestion de incidentes de TI",
  "private": true,
  "main": "backend/src/server.js",
  "files": [
    "backend/src",
    "frontend",
    "README.md"
  ],
  "scripts": {
    "start": "node backend/src/server.js",
    "build": "node devops/scripts/build.js",
    "test": "jest",
    "test:ci": "jest --ci --coverage --reporters=default --reporters=jest-junit"
  },
  "engines": {
    "node": ">=20"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests"
    ],
    "collectCoverageFrom": [
      "backend/src/**/*.js",
      "!backend/src/server.js"
    ],
    "coverageReporters": [
      "text-summary",
      "cobertura"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 95,
        "statements": 95,
        "functions": 95,
        "branches": 90
      }
    }
  },
  "jest-junit": {
    "outputDirectory": "reports",
    "outputName": "junit.xml"
  },
  "dependencies": {
    "express": "5.3.0"
  },
  "devDependencies": {
    "jest": "30.5.2",
    "jest-junit": "17.0.0",
    "supertest": "7.3.1"
  }
}
