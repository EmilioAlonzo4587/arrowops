# Plantilla de configuracion de ArrowOps.
# Copiar a .env (ignorado por git) o definir como variables de entorno del sistema,
# del pipeline (variables secretas / Variable Group) o de GitHub Actions (Secrets).
# Nunca guardar valores reales en este archivo.

# Puerto HTTP (1-65535)
PORT=3000

# Entorno: development | test | production
NODE_ENV=development
