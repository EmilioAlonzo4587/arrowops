# Plantilla de configuracion de ArrowOps.
# Copiar a .env (ignorado por git) o definir como variables de entorno del sistema,
# del pipeline (variables secretas / Variable Group) o de GitHub Actions (Secrets).
# Nunca guardar valores reales en este archivo.

# Puerto HTTP (1-65535)
PORT=3000

# Entorno: development | test | production
NODE_ENV=development

# PostgreSQL (database/docker-compose.yml). Valores SECRETOS: definirlos solo en .env
# o en el almacen de secretos del pipeline; nunca en este archivo.
POSTGRES_PASSWORD=
ARROWOPS_DB_PORT=5433
# Si no se define, la app usa el repositorio en memoria.
# Formato: postgres://arrowops:<POSTGRES_PASSWORD>@localhost:5433/arrowops
DATABASE_URL=
